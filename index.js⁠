import express from 'express';
import cors from 'cors';
import ffmpeg from 'fluent-ffmpeg';

const app = express();
app.use(cors());
app.use(express.json());

app.get('/', (req, res) => {
  res.send('CK 3.0 FFmpeg Server is Live and Ready!');
});

app.post('/api/advanced-render', async (req, res) => {
  try {
    const { videoPath, audioPath, logoPath, subtitlePath, outputPath, speed = 1.0, zoom = 1.0, quality = '720p', blurOriginalSub = false } = req.body;

    let scaleFilter = quality === '1080p' ? 'scale=1920:1080' : 'scale=1280:720';
    let ptsSpeed = 1 / speed;
    let complexFilters = [];

    complexFilters.push(`[0:v]setpts=${ptsSpeed}*PTS,${scaleFilter}[v1]`);
    let lastVideoTag = 'v1';

    if (zoom > 1.0) {
      complexFilters.push(`[${lastVideoTag}]scale=iw*${zoom}:-1,crop=iw/${zoom}:ih/${zoom}[vzoom]`);
      lastVideoTag = 'vzoom';
    }

    if (blurOriginalSub) {
      complexFilters.push(`[${lastVideoTag}]crop=iw:100:0:ih-100,boxblur=10:5[blurred]`);
      complexFilters.push(`[${lastVideoTag}][blurred]overlay=0:ih-100[vblur]`);
      lastVideoTag = 'vblur';
    }

    if (logoPath) {
      complexFilters.push(`[1:v]scale=120:-1[logo]`);
      complexFilters.push(`[${lastVideoTag}][logo]overlay=main_w-overlay_w-20:20[vlogo]`);
      lastVideoTag = 'vlogo';
    }

    if (subtitlePath) {
      complexFilters.push(`[${lastVideoTag}]subtitles=${subtitlePath}:force_style='FontSize=20,PrimaryColour=&H00FFFFFF&'[vsub]`);
      lastVideoTag = 'vsub';
    }

    let command = ffmpeg().input(videoPath);
    if (logoPath) command.input(logoPath);
    command.input(audioPath);

    command
      .complexFilter(complexFilters, lastVideoTag)
      .outputOptions(['-c:v libx264', '-preset fast', '-c:a aac', '-map', `[${lastVideoTag}]`, '-map 2:a:0', '-shortest'])
      .output(outputPath)
      .on('end', () => res.json({ success: true, message: 'Render finished', outputPath }))
      .on('error', (err) => res.status(500).json({ success: false, error: err.message }))
      .run();

  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`FFmpeg Server running on port ${PORT}`));
